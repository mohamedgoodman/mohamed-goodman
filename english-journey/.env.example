# --- English Journey environment ---------------------------------------------
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; development falls back to a fixed insecure value.
AUTH_SECRET=

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app stores everything in
# a JSON file under ./.data, so there is nothing to install or run.
#
# Set it for any real deployment — and ALWAYS on serverless hosts (Vercel,
# Netlify, Cloudflare), where the filesystem is wiped between requests and
# deploys. On Neon or Supabase use the POOLED connection string.
#   postgres://user:password@host/database
DATABASE_URL=

# TLS. Auto-detected: off for localhost, on for everything else.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Where the JSON store writes when DATABASE_URL is unset. Defaults to ./.data
DATA_DIR=

# --- AI provider (optional) ---------------------------------------------------
# Leave AI_PROVIDER unset (or "mock") to run fully offline with the built-in
# deterministic content engine. Set to "openai" to plug in a real model.
# Keys are read on the server only — never import these from client components.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
