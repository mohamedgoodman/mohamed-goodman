# ---------------------------------------------------------------------------
# Nina Redlyn — fan desk
# Copy this file to .env and fill it in. Never commit the filled-in .env.
# ---------------------------------------------------------------------------

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram user id — ask @userinfobot. Comma-separated if more than one
# person works the inbox; the first id is where fan messages are delivered.
ADMIN_IDS=

# --- Optional --------------------------------------------------------------

# The first thing a new fan sees. Keep it factual — it is not a persona.
WELCOME_MESSAGE=

# Where photos live. Defaults to ./media
MEDIA_ROOT=

# Where the SQLite file lives. Defaults to ./storage/bot.db
DB_PATH=

# Seconds before the same auto-reply may fire again for the same fan (600 = 10 min)
AUTO_REPLY_COOLDOWN=600

# Pause between broadcast messages, in seconds. 0.05 ≈ 20 per second.
BROADCAST_INTERVAL=0.05

# DEBUG shows every update; INFO is the sensible default.
LOG_LEVEL=INFO
