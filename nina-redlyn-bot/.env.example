# ---------------------------------------------------------------------------
# Nina Redlyn bot — environment
# Copy to `.env` for local work; set the same keys in Vercel for production.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

# From @BotFather
BOT_TOKEN=

# The channel to publish to: @handle for a public channel, or the numeric id
# (starts with -100…) for a private one.
CHANNEL_ID=@nina_redlyn

# The discussion group linked to the channel. Leave empty to disable
# moderation entirely.
GROUP_ID=

# Telegram user ids allowed to compose, schedule and broadcast.
# Get yours from @userinfobot. Comma-separated for several admins.
ADMIN_IDS=

# Supabase — Project settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Telegram echoes it on every webhook call so nobody
# else can post updates to your endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Protects /api/cron/tick from being called by anyone. Same generator.
CRON_SECRET=

# Appended to every published post. Leave empty for none.
SIGNATURE=<b>NINA REDLYN</b>

# Timezone used to read and display scheduling times.
TIMEZONE=Africa/Casablanca
